# Copy this file to .env and fill in your own values.
# NEVER put real keys in .env.example (it is committed to GitHub).

# ---- LLM provider: groq | openai | gemini | mistral | anthropic ----
LLM_PROVIDER=groq

# Groq (default) — get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional alternative providers (only needed if you change LLM_PROVIDER)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Embeddings: sentence-transformers (laptop) | onnx (server, no PyTorch) ----
EMBEDDING_BACKEND=sentence-transformers

# ---- API server ----
# Comma-separated list of sites allowed to call the API (use * while testing)
ALLOWED_ORIGINS=*
